# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the login session cookie. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Where Supabase sends users after they click the email confirmation link.
SITE_URL=http://localhost:8000

# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google exactly.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
